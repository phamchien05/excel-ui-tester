<mxfile host="app.diagrams.net"><diagram id="Hinh_2_2_kien_truc" name="Hinh_2_2_kien_truc"><mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="540" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;font style='font-size:13px'&gt;Giao diện Web (app.py) và dòng lệnh (main.py) gọi mọi chức năng bên dưới&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="24" y="20" width="712" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Viết tay&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;người kiểm thử&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="24" y="92" width="160" height="58" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Tự sinh test case&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;generator.py&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="204" y="92" width="160" height="58" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Ghi thao tác&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;recorder.py&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="384" y="92" width="160" height="58" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Kiểm tra nhanh&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;smoke.py&lt;/font&gt;" style="rounded=1;arcSize